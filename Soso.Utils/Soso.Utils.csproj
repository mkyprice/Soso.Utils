<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- NuGet Package Metadata -->
        <PackageId>soso.utils</PackageId>
        <Version>1.0.0</Version>
        <Authors>Ky Price</Authors>
        <Company>Chronic Vagrant</Company>
        <Description>A collection of helpful utilities</Description>
        <PackageTags>utils</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mkyprice/Soso.Utils</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Automatically build package on every Release build -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
